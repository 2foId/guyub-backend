MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=guyub.ngapak@gmail.com
MAIL_PASS=zdruasgbwzcejfwu  # App Password, tanpa spasi
MAIL_FROM="Guyub Ngapak <guyub.ngapak@gmail.com>"
